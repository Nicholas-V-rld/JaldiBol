# --- LiveKit Cloud (https://cloud.livekit.io) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram STT (https://console.deepgram.com) ---
DEEPGRAM_API_KEY=

# --- Cartesia TTS (https://play.cartesia.ai) ---
CARTESIA_API_KEY=

# --- Google Gemini (https://aistudio.google.com) ---
GEMINI_API_KEY=

# --- OpenAI (fallback LLM / eval judge) ---
OPENAI_API_KEY=

# --- Model overrides ---
# config.py defaults to "gemini-3.5-flash-lite", which the Google plugin does not
# recognize and the Gemini API rejects. Override with a valid model:
GEMINI_MODEL=gemini-3.5-flash
